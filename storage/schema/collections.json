        "status",
        "featured",
        "name",
        "eyebrow",
        "headline",
        "subheadline",
        "description",
        "date_label",
        "start_time",
        "end_time",
        "time_label",
        "timezone",
        "delivery_mode",
        "mode",
        "slot_label",
        "total_slots",
        "remaining_slots",
        "price",
        "currency",
        "payment_mode",
        "payment_page_url",
        "cta_label",
        "logo_url",
        "hero_image_url",
        "thumbnail_url",
        "organizers",
        "contact_email",
        "contact_phone"

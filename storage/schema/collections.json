{
  "version": 2,
  "purpose": "Agent-readable JSON database schema for the GutConference PHP hosting CMS. Update this file before changing storage/data collection shapes, admin fields, media fields, or assistant-visible context.",
  "collections": {
    "users": {
      "file": "storage/data/users.json",
      "primary_key": "id",
      "owner_field": "email",
      "admin_managed": false,
      "agent_context": [
        "id",
        "email",
        "name",
        "certificate_name",
        "role"
      ],
      "fields": {
        "id": {
          "type": "string",
          "required": true
        },
        "email": {
          "type": "email",
          "required": true
        },
        "name": {
          "type": "string"
        },
        "certificate_name": {
          "type": "string"
        },
        "role": {
          "type": "enum",
          "values": [
            "customer",
            "admin"
          ]
        },
        "google_sub": {
          "type": "string"
        },
        "google_email_verified": {
          "type": "boolean"
        },
        "google_calendar_enabled": {
          "type": "boolean",
          "description": "True only when the user actually granted a Calendar scope at sign-in. Calendar scope is currently omitted from the OAuth request (gutconference.online's Google Cloud project has Calendar API disabled, so the scope is rejected with invalid_scope). Re-enable by enabling Google Calendar API in Google Cloud Console and re-adding the scope to GoogleOAuthClient::authUrl()."
        },
        "google_oauth_scope": {
          "type": "string",
          "description": "Space-separated Google OAuth scopes returned in the access token. Currently openid email profile only; calendar scope is omitted until Google Calendar API is enabled in Google Cloud Console."
        },
        "google_token_expires_at": {
          "type": "number"
        },
        "google_refresh_token": {
          "type": "secret"
        },
        "newsletter_opt_in": {
          "type": "boolean"
        },
        "password_hash": {
          "type": "secret"
        },
        "terms_accepted_at": {
          "type": "number",
          "description": "Unix timestamp of when the user accepted /terms. Set by AuthController::signupPost and AuthController::loginPost when the consent checkbox is ticked, and by AuthController::googleCallback on OAuth sign-in."
        },
        "privacy_accepted_at": {
          "type": "number",
          "description": "Unix timestamp of when the user accepted /privacy. Set by AuthController::signupPost and AuthController::loginPost when the consent checkbox is ticked, and by AuthController::googleCallback on OAuth sign-in."
        },
        "consent_version": {
          "type": "string",
          "description": "The version of the policies the user accepted (e.g. 'v1-2026-06-07'). Bump when /terms or /privacy content is materially updated and the user is asked to re-accept."
        },
        "consent_via": {
          "type": "enum",
          "values": [
            "manual_form",
            "google_oauth",
            "admin_create",
            "legacy"
          ],
          "description": "How the user accepted /terms and /privacy. manual_form = in-app checkbox on /signup or /login. google_oauth = consent recorded at the OAuth callback after the Google consent screen. admin_create = account created in /admin. legacy = account predates the consent field and has not yet re-accepted."
        },
        "consent_ip": {
          "type": "string",
          "description": "IP address captured at the time of consent acceptance. Optional audit field; may be empty for OAuth or admin-created users."
        }
      }
    },
    "events": {
      "file": "storage/data/events.json",

      "agent_context": [
        "id",
        "slug",
        "status",
        "featured",
        "name",
        "headline",
        "date_label",
        "start_time",
        "end_time",
        "time_label",
        "timezone",
        "delivery_mode",
        "mode",
        "slot_label",
        "total_slots",
        "remaining_slots",
        "payment_mode",
        "payment_page_url"
      ],
      "fields": {
        "id": {
          "type": "string",
          "required": true
        },
        "slug": {
          "type": "slug",
          "required": true
        },
        "status": {
          "type": "enum",
          "values": [
            "draft",
            "published",
            "archived"
          ]
        },
        "featured": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "required": true
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "subheadline": {
          "type": "text"
        },
        "description": {
          "type": "text"
        },
        "date_label": {
          "type": "string"
        },
        "start_time": {
          "type": "time"
        },
        "end_time": {
          "type": "time"
        },
        "time_label": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "delivery_mode": {
          "type": "enum",
          "values": [
            "online",
            "direct"
          ]
        },
        "mode": {
          "type": "string"
        },
        "slot_label": {
          "type": "string"
        },
        "total_slots": {
          "type": "number"
        },
        "remaining_slots": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "payment_mode": {
          "type": "enum",
          "values": [
            "payment_page",
            "razorpay_integration"
          ]
        },
        "payment_page_url": {
          "type": "url"
        },
        "registration_url": {
          "type": "url"
        },
        "cta_label": {
          "type": "string"
        },
        "logo_url": {
          "type": "local_or_remote_path"
        },
        "hero_image_url": {
          "type": "local_or_remote_path"
        },
        "thumbnail_url": {
          "type": "local_or_remote_path"
        },
        "organizers": {
          "type": "string"
        },
        "contact_email": {

{
  "version": 2,
  "purpose": "Agent-readable JSON database schema for the GutConference PHP hosting CMS. Update this file before changing storage/data collection shapes, admin fields, media fields, or assistant-visible context.",
  "collections": {
    "users": {
      "file": "storage/data/users.json",
      "primary_key": "id",
      "owner_field": "email",
      "admin_managed": false,
      "agent_context": ["id", "email", "name", "role"],
      "fields": {
        "id": {"type": "string", "required": true},
        "email": {"type": "email", "required": true},
        "name": {"type": "string"},
        "role": {"type": "enum", "values": ["customer", "admin"]},
        "password_hash": {"type": "secret"}
      }
    },
    "events": {
      "file": "storage/data/events.json",
      "primary_key": "id",
      "admin_managed": true,
      "media_fields": ["logo_url", "hero_image_url", "thumbnail_url"],
      "admin_fields": ["slug", "status", "featured", "name", "eyebrow", "headline", "subheadline", "description", "date_label", "start_time", "end_time", "time_label", "timezone", "mode", "slot_label", "total_slots", "remaining_slots", "price", "currency", "registration_url", "cta_label", "logo_url", "hero_image_url", "thumbnail_url", "organizers", "contact_email", "contact_phone"],
      "agent_context": ["id", "slug", "status", "featured", "name", "headline", "date_label", "start_time", "end_time", "time_label", "timezone", "mode", "slot_label", "total_slots", "remaining_slots", "registration_url"],
      "fields": {
        "id": {"type": "string", "required": true},
        "slug": {"type": "slug", "required": true},
        "status": {"type": "enum", "values": ["draft", "published", "archived"]},
        "featured": {"type": "boolean"},
        "name": {"type": "string", "required": true},
        "eyebrow": {"type": "string"},
        "headline": {"type": "string"},
        "subheadline": {"type": "text"},
        "description": {"type": "text"},
        "date_label": {"type": "string"},
        "start_time": {"type": "time"},
        "end_time": {"type": "time"},
        "time_label": {"type": "string"},
        "timezone": {"type": "string"},
        "mode": {"type": "string"},
        "slot_label": {"type": "string"},
        "total_slots": {"type": "number"},
        "remaining_slots": {"type": "number"},
        "price": {"type": "number"},
        "currency": {"type": "string"},
        "registration_url": {"type": "url"},
        "cta_label": {"type": "string"},
        "logo_url": {"type": "local_or_remote_path"},
        "hero_image_url": {"type": "local_or_remote_path"},
        "thumbnail_url": {"type": "local_or_remote_path"},
        "organizers": {"type": "string"},
        "contact_email": {"type": "email"},
        "contact_phone": {"type": "string"}
      }
    },
    "event_sections": {
      "file": "storage/data/event_sections.json",
      "primary_key": "id",
      "admin_managed": true,
      "admin_fields": ["event_slug", "type", "enabled", "sort_order", "title", "subtitle", "body", "items"],
      "agent_context": ["event_slug", "type", "enabled", "sort_order", "title", "body", "items"],
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug", "required": true},
        "type": {"type": "enum", "values": ["outcomes", "audience", "trust", "bonus", "faq", "policy", "custom"]},
        "enabled": {"type": "boolean"},
        "sort_order": {"type": "number"},
        "title": {"type": "string"},
        "subtitle": {"type": "text"},
        "body": {"type": "text"},
        "items": {"type": "array", "items": "string"}
      }
    },
    "speakers": {
      "file": "storage/data/speakers.json",
      "primary_key": "id",
      "admin_managed": true,
      "media_fields": ["photo_url"],
      "admin_fields": ["event_slug", "sort_order", "name", "country", "topic", "session_time", "profile", "photo_url"],
      "agent_context": ["event_slug", "name", "country", "topic", "session_time", "profile"],
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug", "required": true},
        "sort_order": {"type": "number"},
        "name": {"type": "string", "required": true},
        "country": {"type": "string"},
        "topic": {"type": "string"},
        "session_time": {"type": "string"},
        "profile": {"type": "text"},
        "photo_url": {"type": "local_or_remote_path"}
      }
    },
    "sessions": {
      "file": "storage/data/sessions.json",
      "primary_key": "id",
      "admin_managed": true,
      "admin_fields": ["event_slug", "sort_order", "time_label", "title", "speaker_name", "description"],
      "agent_context": ["event_slug", "time_label", "title", "speaker_name"],
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug", "required": true},
        "sort_order": {"type": "number"},
        "time_label": {"type": "string"},
        "title": {"type": "string", "required": true},
        "speaker_name": {"type": "string"},
        "description": {"type": "text"}
      }
    },
    "venues": {
      "file": "storage/data/venues.json",
      "primary_key": "id",
      "admin_managed": true,
      "media_fields": ["image_url"],
      "admin_fields": ["event_slug", "name", "mode", "address", "map_link", "map_embed_url", "joining_note", "image_url"],
      "agent_context": ["event_slug", "name", "mode", "address", "map_link", "joining_note"],
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug", "required": true},
        "name": {"type": "string"},
        "mode": {"type": "string"},
        "address": {"type": "text"},
        "map_link": {"type": "url"},
        "map_embed_url": {"type": "url"},
        "joining_note": {"type": "text"},
        "image_url": {"type": "local_or_remote_path"}
      }
    },
    "registrations": {
      "file": "storage/data/registrations.json",
      "primary_key": "id",
      "owner_field": "email",
      "admin_managed": true,
      "agent_context": ["id", "event_slug", "name", "email", "phone", "profession", "payment_status", "created_at"],
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug"},
        "name": {"type": "string"},
        "email": {"type": "email"},
        "phone": {"type": "string"},
        "profession": {"type": "string"},
        "payment_status": {"type": "enum", "values": ["pending", "paid", "failed", "manual"]},
        "razorpay_order_id": {"type": "string"},
        "razorpay_payment_id": {"type": "string"},
        "created_at": {"type": "datetime"}
      }
    },
    "notification_templates": {
      "file": "storage/data/notification_templates.json",
      "primary_key": "id",
      "admin_managed": true,
      "admin_fields": ["key", "channel", "enabled", "subject", "template_name", "language", "body"],
      "fields": {
        "id": {"type": "string"},
        "key": {"type": "slug"},
        "channel": {"type": "enum", "values": ["email", "whatsapp"]},
        "enabled": {"type": "boolean"},
        "subject": {"type": "string"},
        "template_name": {"type": "string"},
        "language": {"type": "string"},
        "body": {"type": "text"}
      }
    },
    "notification_queue": {
      "file": "storage/data/notification_queue.json",
      "primary_key": "id",
      "admin_managed": true,
      "fields": {
        "id": {"type": "string"},
        "event_slug": {"type": "slug"},
        "registration_id": {"type": "string"},
        "channel": {"type": "enum", "values": ["email", "whatsapp"]},
        "to": {"type": "string"},
        "template_key": {"type": "slug"},
        "status": {"type": "enum", "values": ["pending", "sent", "failed"]},
        "available_at": {"type": "datetime"},
        "created_at": {"type": "datetime"}
      }
    },
    "contact_submissions": {
      "file": "storage/data/contact_submissions.json",
      "primary_key": "id",
      "admin_managed": true,
      "fields": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "email": {"type": "email"},
        "phone": {"type": "string"},
        "subject": {"type": "string"},
        "message": {"type": "text"},
        "status": {"type": "string"}
      }
    },
    "settings": {
      "file": "storage/data/settings.json",
      "primary_key": "id",
      "fields": {
        "id": {"type": "string"},
        "key": {"type": "string"},
        "value": {"type": "object"}
      }
    },
    "audit_events": {
      "file": "storage/data/audit_events.json",
      "primary_key": "id",
      "fields": {
        "id": {"type": "string"},
        "action": {"type": "string"},
        "collection": {"type": "string"},
        "record_id": {"type": "string"},
        "meta": {"type": "object"},
        "created_at": {"type": "datetime"}
      }
    },
    "media_files": {
      "file": "storage/data/media_files.json",
      "primary_key": "id",
      "admin_managed": true,
      "fields": {
        "id": {"type": "string"},
        "filename": {"type": "string"},
        "original_name": {"type": "string"},
        "path": {"type": "local_or_remote_path"},
        "context": {"type": "enum", "values": ["shared", "events", "speakers", "venues"]},
        "mime": {"type": "string"},
        "created_at": {"type": "datetime"}
      }
    }
  }
}
